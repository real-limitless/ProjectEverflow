# Copy to .env and adjust for local/prod.
# Quick start: ./scripts/everflow-install.sh

# development | staging | production | test
# production refuses default SECRET_KEY / SANDBOX_AGENT_TOKEN at API startup
ENVIRONMENT=development

# Shared secret between backend and sandbox-agent (required — rotate in production)
SANDBOX_AGENT_TOKEN=dev-sandbox-token-change-me

# false = real microVMs via official microsandbox runtime (required for Everflow)
# true  = in-memory mock only (CI / machines without KVM — not for product use)
SANDBOX_MOCK=false

SANDBOX_ENABLED=true
# Guest microVM image (NOT the sandbox-agent host image).
# Build prebaked tools (Node + Claude Code + OpenCode):
#   ./deploy/build-sandbox-guest.sh
# Prefer prebaked guest image so harnesses are already on PATH (no apt/npm at create).
# Published: ghcr.io/limitless-rh/everflow-sandbox-guest:dev (or :latest)
# Stock aliases (python) still work; bootstrap installs tools only if missing.
SANDBOX_DEFAULT_IMAGE=ghcr.io/limitless-rh/everflow-sandbox-guest:dev
SANDBOX_DEFAULT_MEMORY_MIB=2048
SANDBOX_DEFAULT_CPUS=2

# App toolkits: local seed tree (default /toolkits in the API container).
# Optionally publish each toolkit as its own git repo and set:
#   TOOLKIT_REPO_BASE=https://github.com/org/everflow-toolkit-{id}.git
# UI can mirror the same pattern with VITE_TOOLKIT_REPO_BASE.
TOOLKIT_LOCAL_ROOT=/toolkits
# TOOLKIT_REPO_BASE=
# VITE_TOOLKIT_REPO_BASE=
# Mount strategy for sandbox-agent: named-volume | bind | no-volumes | auto (default)
# VOLUME_STRATEGY=auto

# JWT + general signing — MUST be unique and long in production
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Dedicated Fernet key for provider/git/deploy secrets (recommended in production)
# CREDENTIALS_ENCRYPTION_KEY=

# Prefer PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://everflow:everflow@db:5432/everflow
DATABASE_URL=sqlite+aiosqlite:////data/everflow.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production compose UI is :3000; docker-compose.dev.yml defaults FRONTEND_URL to :5173
FRONTEND_URL=http://localhost:3000

# Browser-facing API base (Vite build + Vite dev server)
VITE_API_URL=http://localhost:8000

# Browser-facing API URL
PUBLIC_API_URL=http://localhost:8000
# Platform API as seen by sandbox-agent (compose service DNS). Agent reverse-tunnels
# this into the guest as http://127.0.0.1:18765 for everflow-mcp.
AGENT_PLATFORM_API_URL=http://backend:8000
# On sandbox-agent container, same value:
# PLATFORM_API_URL=http://backend:8000
# Sandbox MCP access token lifetime (seconds); default 86400
# SANDBOX_TOKEN_TTL_SECONDS=86400

# Optional OAuth (Sign in with GitHub / Google) — also set OAUTH_REDIRECT_BASE_URL
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Live Preview edge (iframe Host-based proxy on platform-api).
# Local: always include a port — bare preview.localhost would hit browser :80.
# Production: PREVIEW_BASE_DOMAIN=preview.example.com + PREVIEW_PUBLIC_SCHEME=https
PREVIEW_ENABLED=true
PREVIEW_BASE_DOMAIN=preview.localhost:8000
PREVIEW_PUBLIC_SCHEME=http
# Optional override if base has no :port: PREVIEW_PUBLIC_PORT=8000

# UI: true = offline mock catalog (no login). Default: API auth required.
# VITE_DEMO_MODE=true

# Optional: force Vite file polling inside Docker if HMR misses edits
# VITE_USE_POLLING=true
# CHOKIDAR_USEPOLLING=true

# SearXNG (internal compose service; used by backend knowledge web-search)
SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=everflow-dev-searxng-change-me

# HTTP tools SSRF: allow RFC1918/loopback for sandbox-internal targets (metadata/link-local still blocked)
# HTTP_TOOLS_ALLOW_SANDBOX_INTERNAL=false
# HTTP_TOOLS_REQUEST_TIMEOUT_SECONDS=30
