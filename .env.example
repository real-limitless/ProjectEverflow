# Copy to .env and adjust for local/prod.

# Shared secret between backend and sandbox-agent (required)
SANDBOX_AGENT_TOKEN=dev-sandbox-token-change-me

# true = in-memory mock sandboxes (no real microVMs)
# false = use microsandbox SDK + /dev/kvm inside sandbox-agent
SANDBOX_MOCK=true

SANDBOX_ENABLED=true
SANDBOX_DEFAULT_IMAGE=ubuntu:24.04
SANDBOX_DEFAULT_MEMORY_MIB=2048
SANDBOX_DEFAULT_CPUS=2

SECRET_KEY=change-me-in-production-use-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:////data/everflow.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Browser-facing API base (used at frontend build time)
VITE_API_URL=http://localhost:8000
