APP_NAME=Everflow Platform API
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Optional dedicated key for encrypting provider API keys (falls back to SECRET_KEY)
CREDENTIALS_ENCRYPTION_KEY=
DATABASE_URL=sqlite+aiosqlite:///./data/everflow.db
# DATABASE_URL=postgresql+asyncpg://everflow:everflow@localhost:5432/everflow
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# OAuth — leave empty to disable providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# SearXNG for knowledge web-search (compose: http://searxng:8080)
SEARXNG_URL=http://localhost:8080

# HTTP tools outbound fetch (SSRF: private/loopback blocked unless sandbox-internal allowed)
# HTTP_TOOLS_ALLOW_SANDBOX_INTERNAL=false
# HTTP_TOOLS_REQUEST_TIMEOUT_SECONDS=30
