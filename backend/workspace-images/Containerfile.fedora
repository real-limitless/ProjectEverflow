# Fedora 43 Development Workspace
# Pre-built image with essential development tools for AI-assisted code editing
FROM fedora:43

LABEL maintainer="PatternFly Dash Brew"
LABEL description="Fedora 43 workspace with git, Python, Node.js, development tools, and Copilot Mode agent"
LABEL version="1.1"

# Set working directory
WORKDIR /workspace

# Install essential development tools
RUN dnf update -y && \
    dnf install -y \
    # Version control
    git \
    # Python ecosystem
    python3 \
    python3-pip \
    python3-devel \
    # Node.js ecosystem
    nodejs \
    npm \
    # Build tools
    gcc \
    gcc-c++ \
    make \
    cmake \
    # Editors
    vim \
    nano \
    # Utilities
    curl \
    wget \
    tar \
    gzip \
    unzip \
    which \
    findutils \
    diffutils \
    patch \
    # Additional tools
    jq \
    htop \
    # For agent service
    procps-ng \
    && dnf clean all

# Create non-root user for workspace operations
RUN useradd -m -u 1000 -s /bin/bash workspace && \
    chown -R workspace:workspace /workspace

# Create agent directory structure
RUN mkdir -p /opt/agent && \
    chown -R workspace:workspace /opt/agent

# Copy agent service files
COPY agent/agent_service.py /opt/agent/agent_service.py
COPY agent/requirements.txt /opt/agent/requirements.txt

# Install agent dependencies as root (system-wide)
RUN pip3 install --no-cache-dir -r /opt/agent/requirements.txt

# Switch to workspace user
USER workspace

# Set environment variables
ENV HOME=/home/workspace
ENV PATH="${HOME}/.local/bin:${PATH}"
ENV AGENT_PORT=8080

# Create entrypoint script that can optionally start the agent
RUN printf '#!/bin/bash\n\
if [ "$COPILOT_MODE" = "true" ]; then\n\
    echo "[Workspace] Starting Copilot Mode agent on port $AGENT_PORT" > /home/workspace/.agent/agent.log 2>&1\n\
    mkdir -p /home/workspace/.agent/logs\n\
    nohup python3 /opt/agent/agent_service.py >> /home/workspace/.agent/agent.log 2>&1 &\n\
fi\n\
# Keep container running\n\
exec tail -f /dev/null\n\
' > /home/workspace/entrypoint.sh && chmod +x /home/workspace/entrypoint.sh

# Expose agent port
EXPOSE 8080

# Use entrypoint script
CMD ["/home/workspace/entrypoint.sh"]
